<%# locals: form (Admin::HouseholdForm), url, method %>
<%= form_with model: form, scope: :household, url: url, method: method, class: "panel-card detail-card" do |f| %>
  <%= family_form_errors form %>

  <%= detail_section "Caregiver" do %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control", required: true %>
      </div>
      <div class="col-md-6">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control", required: true %>
      </div>
      <div class="col-md-6">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true %>
        <% unless form.persisted? %>
          <div class="form-text">We email a link so the caregiver can choose a password and finish intake.</div>
        <% end %>
      </div>
      <div class="col-md-3">
        <%= f.label :phone, class: "form-label" %>
        <%= f.telephone_field :phone, class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= f.label :preferred_language, class: "form-label" %>
        <%= f.text_field :preferred_language, class: "form-control", placeholder: "English" %>
      </div>
    </div>
  <% end %>

  <%= detail_section "The home" do %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :display_name, "Household name", class: "form-label" %>
        <%= f.text_field :display_name, class: "form-control", placeholder: "The Brooks home" %>
        <div class="form-text">Staff only. Left blank, it is named after the caregiver.</div>
      </div>
      <div class="col-md-6">
        <%= f.label :county, class: "form-label" %>
        <%= f.select :county, form.counties, { include_blank: "Choose a county" }, class: "form-select" %>
      </div>
      <div class="col-md-6">
        <%= f.label :placing_organization_id, "Placing agency", class: "form-label" %>
        <%= f.collection_select :placing_organization_id, form.agencies, :id, :name,
                                { include_blank: "Not recorded" }, class: "form-select" %>
      </div>
      <div class="col-md-6">
        <%= f.label :payout_method, class: "form-label" %>
        <%= f.select :payout_method, Admin::HouseholdsTable::PAYOUT_METHODS, {}, class: "form-select" %>
        <div class="form-text">Direct deposit also needs the caregiver to finish Stripe onboarding.</div>
      </div>
      <div class="col-md-6">
        <%= f.label :gift_card_email, "Email for the gift card", class: "form-label" %>
        <%= f.email_field :gift_card_email, class: "form-control" %>
        <div class="form-text">Where Tremendous sends the gift card. Usually the caregiver's own email.</div>
      </div>
    </div>
  <% end %>

  <div class="drawer-actions">
    <%= f.button class: "btn btn-primary" do %><i class="bi bi-check2 me-1"></i><%= form.persisted? ? "Save household" : "Add household" %><% end %>
    <%= link_to "Cancel", form.persisted? ? admin_household_path(form.household) : admin_households_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
