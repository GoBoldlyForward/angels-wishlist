<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "For caregivers | Wish List" %></title>
    <meta name="description" content="Foster and kinship caregivers: build a wish list for each child in your home, and get the funds to buy the gifts yourself.">
    <%= render "layouts/head" %>
    <%= render "layouts/storefront_styles", organization: current_chapter %>
    <%= stylesheet_link_tag "caregiver", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= pinpoint_widget %>
  </head>

  <body data-controller="caregiver-dialog">
    <header class="hdr">
      <div class="container hdr-in">
        <%= link_to caregiver_root_path, class: "brand" do %>
          <%= chapter_mark %>
          <span class="brand-name"><%= chapter_name %><span>Wish List</span></span>
        <% end %>
        <nav class="hdr-nav">
          <%= link_to "See the donor view", root_path, class: "hdr-link hide-sm" %>
          <%= yield :header_actions %>
          <a class="hdr-link" href="#help" data-action="caregiver-dialog#open"><i class="fa-solid fa-circle-question"></i> &nbsp;Need help?</a>
          <% if user_signed_in? %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "hdr-link btn-plain" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "hdr-link" %>
          <% end %>
        </nav>
      </div>
    </header>
    <% if flash.any? %><div class="container" style="max-width:1040px"><%= render "shared/flash" %></div><% end %>
    <%= yield %>
    <footer class="ftr">
      <div class="container ftr-in">
        <div style="display:flex; align-items:center; gap:10px">
          <%= chapter_mark style: "height:28px" %>
          <div>
            <div class="t-base w-700 ink"><%= chapter_name %></div>
            <div class="tiny">Consistent relationships are the solution.</div>
          </div>
        </div>
        <div class="tiny" style="max-width:520px">
          Anything you enter about a child stays with <%= chapter_name %> staff.
          Donors see a stand-in name, an age, and the interests you write.
        </div>
      </div>
    </footer>
    <%= render "caregiver/shared/help" %>
    <%= yield :overlays %>
  </body>
</html>
