<% content_for :title, "#{@category.name} | Wish List" %>
<% available = @gifts.select(&:available?) %>
<% children_count = available.map { |gift| gift.child.key }.uniq.size %>
<% prices = available.map(&:price_in_cents) %>
<% starting = [ 2, available.size ].min %>
<% shown = Storefront::Product.group(@gifts.select { |gift| @filters.matches?(gift) }) %>

<main>
  <div class="cat-hero">
    <div class="container">
      <%= link_to root_path(anchor: "shop"), class: "btn-plain" do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> &nbsp;All categories
      <% end %>
      <div class="cat-head">
        <div>
          <span class="cat-eyebrow"><i class="fa-solid <%= @category.icon %>" aria-hidden="true"></i> <%= @category.name %></span>
          <h1><%= @category.headline.presence || @category.name %></h1>
          <p class="cat-lede">
            <%= pluralize available.size, "gift" %> in this category <%= available.one? ? "is" : "are" %> still
            unfunded, asked for by <%= pluralize children_count, "child" %> across
            <%= pluralize @catalog.household_count(available), "verified household" %>.
          </p>
        </div>

        <div class="panel cat-cta">
          <h2 class="t-md">Fund this category</h2>
          <p class="tiny muted cat-cta-lede">We apply each gift to the child who has been waiting longest.</p>
          <% if available.any? %>
            <%= form_with url: category_funding_path(@category),
                          data: { controller: "shop-stepper", shop_stepper_prices_value: prices.to_json } do |form| %>
              <div class="stepper-row cat-stepper">
                <div class="stepper">
                  <button class="step-btn" type="button" hidden aria-label="One fewer"
                          data-shop-stepper-target="less" data-action="shop-stepper#less">
                    <i class="fa-solid fa-minus" aria-hidden="true"></i>
                  </button>
                  <%= form.label :quantity, "How many gifts to fund", class: "sr-only" %>
                  <%= form.number_field :quantity, value: starting, min: 1, max: available.size, class: "step-n",
                                                   required: true,
                                                   data: { shop_stepper_target: "quantity",
                                                           action: "input->shop-stepper#refresh" } %>
                  <button class="step-btn" type="button" hidden aria-label="One more"
                          data-shop-stepper-target="more" data-action="shop-stepper#more">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="stepper-total">
                  <div class="tiny muted">gifts from this category</div>
                  <div class="price" data-shop-stepper-target="total"><%= money prices.first(starting).sum %></div>
                </div>
              </div>
              <%= form.button class: "btn btn-primary btn-block" do %>
                Add <span data-shop-stepper-target="count"><%= starting %></span> to cart
              <% end %>
            <% end %>
            <%= button_to "Cover the whole category · #{money prices.sum}", category_funding_path(@category),
                          params: { whole_category: 1 }, class: "btn btn-ghost btn-block cat-cover" %>
            <p class="tiny muted cat-cta-count">
              <%= pluralize available.size, "gift" %> for <%= pluralize children_count, "child" %>
            </p>
          <% else %>
            <p class="muted m-0">Every gift in this category is funded or already in your cart.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <%= render "public/shared/filters", filters: @filters,
               url: ->(query) { category_path(@category, query) } %>

    <div class="sec">
      <div class="sec-head">
        <div>
          <h2>Everything on this list</h2>
          <p><%= pluralize shown.size, "product" %>, grouped so repeats show as one tile.</p>
        </div>
      </div>
      <div class="grid">
        <% if shown.any? %>
          <%= render partial: "public/shared/product_tile", collection: shown, as: :product %>
        <% else %>
          <p class="muted">Nothing matches these filters.</p>
        <% end %>
      </div>
    </div>

    <div class="sec">
      <div class="sec-head"><div><h2>Other categories</h2></div></div>
      <div class="chip-scroll other-categories">
        <% @catalog.categories.reject { |category| category.id == @category.id }.each do |category| %>
          <%= link_to category_path(category), class: "chip" do %>
            <i class="fa-solid <%= category.icon %> chip-icon" aria-hidden="true"></i><%= category.name %>
            <span class="chip-count"><%= @catalog.category_gifts(category).count { |gift| !gift.funded? } %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</main>
