<% content_for :breadcrumbs do %><li class="breadcrumb-item active">Organizations</li><% end %>
<% sections = { "chapter" => [ "Chapters", "Runs the events and receives every donation." ],
                "agency" => [ "Placing agencies", "Who placed a child with a household. Recorded when staff verify." ],
                "partner" => [ "Partners", "A church or company with its own storefront, in its own skin." ] } %>

<%= render "admin/shared/page_header", title: "Organizations",
           lede: "The chapter, the agencies that place children, and the partners who host a storefront." do %>
  <%= link_to new_admin_organization_path, class: "btn btn-primary btn-sm" do %>
    <i class="bi bi-plus-lg"></i> New organization
  <% end %>
<% end %>

<% sections.each do |kind, (title, lede)| %>
  <% organizations = @organizations.fetch(kind, []) %>
  <div class="data-table-wrapper mb-4">
    <div class="panel-card-head">
      <h2><%= title %> <span class="badge bg-secondary bg-opacity-10 text-secondary"><%= organizations.size %></span></h2>
      <%= link_to "Add one", new_admin_organization_path(kind: kind) %>
    </div>
    <div class="table-scroll">
      <table class="table table-hover">
        <thead><tr><th>Name</th><th>Part of</th><th>Website</th><th>Storefront</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% organizations.each do |organization| %>
            <tr>
              <td class="item-name">
                <%= link_to organization.name, admin_organization_path(organization) %>
                <%= cell_sub organization.short_name if organization.short_name.present? %>
              </td>
              <td><%= organization.parent&.display_name || "—" %></td>
              <td><%= organization.website_url.present? ? link_to(organization.website_url, organization.website_url, target: "_blank", rel: "noopener") : "—" %></td>
              <td>
                <% if organization.partner? %>
                  <%= link_to root_path(storefront: organization.slug), root_path(storefront: organization.slug), target: "_blank", rel: "noopener" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td><%= status_badge organization.active ? "live" : "draft", label: organization.active ? "Active" : "Inactive" %></td>
              <td class="text-end"><%= link_to "Edit", edit_admin_organization_path(organization), class: "btn btn-outline-secondary btn-sm" %></td>
            </tr>
          <% end %>
          <% if organizations.empty? %>
            <tr><td colspan="6" class="text-muted small p-3"><%= lede %> None yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
