<% content_for :title, "Set up your wish lists | #{current_chapter&.name || "Atlanta Angels"}" %>
<% taking_lists = current_event.present? && !current_event.closed? %>

<section class="hero">
  <div class="container">
    <div class="hero-badge"><span><i class="fa-solid fa-lock"></i> &nbsp;For approved foster and kinship caregivers</span></div>
    <h1 class="text-balance">Tell us what they want. You do the shopping.</h1>
    <p class="text-balance">
      Build a list for each child in your home. Donors give toward the gifts, and your household's share of
      everything raised comes to you, so you buy the right size or item in the right week. If a child outgrows
      something or changes their mind, you spend it on what they actually need.
    </p>
    <div style="text-align:center; margin-top:28px">
      <% if taking_lists %>
        <%= link_to caregiver_intake_home_path, class: "btn btn-primary btn-xl" do %>
          Start my lists <i class="fa-solid fa-arrow-right"></i>
        <% end %>
        <p class="tiny muted" style="margin-top:12px">Takes about ten minutes. You can come back to it.</p>
        <% unless user_signed_in? %>
          <p class="tiny" style="margin-top:6px">Already started? <%= link_to "Sign in", new_user_session_path, class: "link" %> to pick up where you left off.</p>
        <% end %>
      <% else %>
        <p class="tiny muted" style="margin-top:12px">Lists are not open right now. Your Angels coordinator will let you know when they are.</p>
      <% end %>
    </div>
  </div>
</section>

<div class="container" style="max-width:900px; padding-bottom:60px">
  <div class="why-grid" style="margin-top:10px">
    <div class="why-card"><i class="fa-solid fa-user-shield"></i><h4>Personal info stays yours</h4>
      <p>Donors never see a school, photo, or name. You buy the fit, so nobody else needs it.</p></div>
    <div class="why-card"><i class="fa-solid fa-shuffle"></i><h4>Change it any time</h4>
      <p>
        Swap a gift for something better
        <%= current_event&.closes_at ? "until lists close on #{event_day(current_event.closes_at)}" : "until lists close" %>.
        The funds follow the child, not the line item.
      </p></div>
    <div class="why-card"><i class="fa-solid fa-building-columns"></i><h4>Paid straight to you</h4>
      <p>Direct deposit in one to two days through Stripe. No bank? A Visa gift card in the mail instead.</p></div>
  </div>
</div>
