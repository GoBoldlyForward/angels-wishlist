<h1>Sign in</h1>
<p class="muted">For caregivers and <%= chapter_name %> staff. Donors do not need an account.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "panel", style: "margin-top:22px" }) do |f| %>
  <div class="field">
    <%= f.label :email, class: "f" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "i" %>
  </div>
  <div class="field">
    <%= f.label :password, class: "f" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "i" %>
  </div>
  <div class="field">
    <label style="display:flex; gap:8px; align-items:center"><%= f.check_box :remember_me %> Keep me signed in</label>
  </div>
  <%= f.submit "Sign in", class: "btn btn-primary btn-block" %>
<% end %>

<p class="tiny" style="margin-top:16px"><%= link_to "Forgot your password?", new_password_path(resource_name), class: "link" %></p>
