<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <%= link_to "Wish List", root_path, class: "navbar-brand" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% if current_user.is_admin? %>
            <li class="nav-item"><%= link_to "Staff", admin_root_path, class: "nav-link" %></li>
          <% elsif current_user.caregiver? %>
            <li class="nav-item"><%= link_to "My lists", caregiver_root_path, class: "nav-link" %></li>
          <% end %>
          <li class="nav-item"><%= link_to "Sign out", destroy_user_session_path, class: "nav-link", data: { turbo_method: :delete } %></li>
        <% else %>
          <li class="nav-item"><%= link_to "Sign in", new_user_session_path, class: "nav-link" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
