<%# locals: (donation:) %>
<%= form_with model: donation, scope: :donor_note, url: admin_donor_note_path(donation), method: :patch,
              namespace: dom_id(donation) do |form| %>
  <%= form.label :note_to_family, "Note to the family", class: "form-label" %>
  <%= form.text_area :note_to_family, rows: 4, maxlength: 1000, required: true, class: "form-control" %>
  <div class="form-text">The families whose gifts this donor chose see it once it is approved. The donor's own wording stays in the audit trail.</div>
  <%= form.button class: "btn btn-primary btn-sm mt-2" do %><i class="bi bi-check2 me-1"></i>Save note<% end %>
<% end %>
