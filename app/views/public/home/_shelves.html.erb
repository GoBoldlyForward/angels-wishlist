<%# locals: (catalog:) -%>
<% almost = catalog.almost_finished %>
<% if almost.any? %>
  <%= render layout: "shelf", locals: { kicker: "Almost there", title: "One gift from a finished list",
                                        blurb: "A single line stands between these kids and a complete list.",
                                        items: almost, more: root_path(tab: "unfunded", anchor: "shop") } do |shown| %>
    <%= render partial: "public/shared/gift_tile", collection: shown, as: :gift %>
  <% end %>
<% end %>

<% untouched = catalog.untouched %>
<% if untouched.any? %>
  <%= render layout: "shelf", locals: { kicker: "Still waiting", tone: "gold", title: "Nobody has funded these yet",
                                        blurb: "No gift on these lists has been chosen yet. Somebody has to go first.",
                                        items: untouched, more: root_path(tab: "children", anchor: "shop") } do |shown| %>
    <%= render partial: "public/shared/child_card", collection: shown, as: :child %>
  <% end %>
<% end %>

<% cheap = catalog.under_forty %>
<% if cheap.any? %>
  <%= render layout: "shelf", locals: { kicker: "Easy yes", tone: "green", title: "Everything under $40",
                                        blurb: "Small gifts finish lists.",
                                        items: cheap, more: root_path(tab: "unfunded", anchor: "shop") } do |shown| %>
    <%= render partial: "public/shared/product_tile", collection: shown, as: :product %>
  <% end %>
<% end %>

<% teens = catalog.teenagers %>
<% if teens.any? %>
  <%= render layout: "shelf", locals: { kicker: "The hard part", title: "Teenagers get skipped",
                                        blurb: "Younger kids get picked first every year. These lists are practical, and they matter more.",
                                        items: teens, more: root_path(tab: "children", age: "13-23", anchor: "shop") } do |shown| %>
    <%= render partial: "public/shared/child_card", collection: shown, as: :child %>
  <% end %>
<% end %>

<% fresh = catalog.new_this_week %>
<% if fresh.any? %>
  <%= render layout: "shelf", locals: { kicker: "Just added", tone: "gold", title: "New lists this week",
                                        blurb: "Lists that went live in the last seven days.",
                                        items: fresh, more: root_path(tab: "children", anchor: "shop") } do |shown| %>
    <%= render partial: "public/shared/child_card", collection: shown, as: :child %>
  <% end %>
<% end %>

<% if [ almost, untouched, cheap, teens, fresh ].any?(&:any?) %><hr class="shelf-rule"><% end %>
