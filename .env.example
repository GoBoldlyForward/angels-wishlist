# Copy to .env and fill in. .env is gitignored; this file is not.

# A second checkout needs its own port and database. PORT is safe in this
# file and it is the only file bin/dev reads. DATABASE_URL is not safe here: a
# DATABASE_URL in .env reaches the test environment too, and the fixtures would
# load over development, so it goes in the per-environment files.
#
#   .env              PORT=3100
#   .env.development  DATABASE_URL=postgres:///angels_wishlist_<name>_development
#   .env.test         DATABASE_URL=postgres:///angels_wishlist_<name>_test

# Stripe. Test keys in development. Leave the secret key blank to run in test mode.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_

# Mail. Production skips every message until SMTP_ADDRESS is set.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Wish List <wishlist@example.org>"
# The host in links inside emails.
APP_HOST=localhost:3000

# Active Storage on S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=angels-wishlist

# Comma-separated origins allowed to call /api. Empty means none.
CORS_ORIGINS=

# Optional
CAREGIVER_HELP_PHONE=
PINPOINT_EMBED_URL=
SEED_PASSWORD=password123
