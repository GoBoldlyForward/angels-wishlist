<h1>Reset your password</h1>
<p class="muted">Enter your email and we will send you a link.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "panel", style: "margin-top:22px" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="field">
    <%= f.label :email, class: "f" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "i" %>
  </div>
  <%= f.submit "Send the link", class: "btn btn-primary btn-block" %>
<% end %>

<p class="tiny" style="margin-top:16px"><%= link_to "Back to sign in", new_session_path(resource_name), class: "link" %></p>
