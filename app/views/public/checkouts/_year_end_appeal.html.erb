<%# locals: (appeal:, cart:) -%>
<% chosen = appeal.tier_for(cart.year_end_gift_in_cents) %>
<section class="panel yeg" id="year-end" aria-labelledby="yeg_title">
  <%= render "public/year_end/hero", appeal: appeal %>

  <% if cart.year_end_gift? %>
    <div class="yeg-chosen" role="status">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      <div class="yeg-chosen-body">
        <div class="t-base w-600 ink">
          <%= money cart.year_end_gift_in_cents %> year-end gift<%= " · #{chosen.title}" if chosen %>
        </div>
        <div class="tiny muted">
          <%= chosen&.body.presence || "Goes directly to #{chapter_name}, on top of the gifts in your cart." %>
        </div>
      </div>
      <%= button_to "Remove", cart_year_end_gift_path, method: :delete, class: "rm",
                    aria: { label: "Remove the year-end gift" } %>
    </div>
  <% end %>

  <details class="yeg-reveal">
    <summary class="btn <%= cart.year_end_gift? ? "btn-ghost" : "btn-ink" %> yeg-open">
      <%= cart.year_end_gift? ? "Change my year-end gift" : "Add a year-end gift" %>
      <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </summary>
    <%= render "public/year_end/tiers", appeal: appeal, cart: cart,
               lede: "Choose what your gift can do. It is added to the donation in your cart.",
               submit_label: "Add to my donation", label_pattern: "Add %{amount} to my donation" %>
  </details>
</section>
